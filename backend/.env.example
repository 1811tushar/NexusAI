# Backend environment (contract section 11). Real .env is git-ignored.
SPRING_PROFILES_ACTIVE=dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexusai
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_dev            # dev default only; REQUIRED in prod
JWT_SECRET=                            # >= 32 chars; REQUIRED in prod (dev has a marked dev default)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14
COOKIE_SECURE=false                    # true in prod
REGISTRATION_OPEN=true                 # false in prod: ADMIN creates users
ADMIN_EMAIL=                           # bootstrap admin, created only if no ADMIN exists
ADMIN_PASSWORD=                        # >= 10 chars, letter + digit; no default exists in code
INTERNAL_API_KEY=                      # shared with ai-service; REQUIRED in prod
AI_SERVICE_URL=http://localhost:8000
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20
MAX_DOCS_TOTAL=500
INGEST_CONCURRENCY=2
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_UPLOAD_PER_MIN=20
RATE_LIMIT_INVESTIGATION_START_PER_MIN=6
BCRYPT_STRENGTH=12
MAX_CONCURRENT_RUNS_PER_USER=2
APPROVAL_TTL_DAYS=7
MAX_LOOPS=3                            # default loops per investigation; hard limit is 5
