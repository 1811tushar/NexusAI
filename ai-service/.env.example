# NexusAI ai-service: every variable from contract section 11 (+ AI A ingestion knobs). Copy to .env (never commit .env).
# --- required (service refuses to start without them) ---
INTERNAL_API_KEY=            # >= 16 chars, shared with the backend. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
AI_DB_RW_PASSWORD=           # password of role ai_rw (set in infra/postgres/init.sql)
AI_DB_RO_PASSWORD=           # password of role ai_readonly

# --- database ---
AI_DB_HOST=postgres
AI_DB_PORT=5432
AI_DB_NAME=nexusai
AI_DB_RW_USER=ai_rw
AI_DB_RO_USER=ai_readonly
DB_POOL_MIN=1
DB_POOL_MAX=8

# --- LLM (AI B; used via core/llm.py) ---
LLM_PROVIDER=gemini          # gemini | ollama | groq
GEMINI_API_KEY=
GEMINI_MODEL=                # MUST be confirmed in Google AI Studio on the day you build
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=                # pick a model with tool-calling support
GROQ_API_KEY=
GROQ_MODEL=

# --- embeddings / retrieval ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5   # "hashing" = deterministic test embedder (tests/CI only, no semantics)
EMBEDDING_DIM=384
CHUNKING_MODE=semantic       # semantic | fixed (fixed only for the ablation)
CHUNK_TOKENS=500
CHUNK_OVERLAP_TOKENS=90
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
TOP_K=8
RETRIEVAL_PER_DOC_CAP=4

# --- ingestion limits ---
MAX_UPLOAD_MB=20
MAX_PAGES=500
MAX_CHARS=3000000
MAX_CHUNKS_PER_DOC=2000
INGEST_TIMEOUT_S=100

# --- agent knobs (AI B) ---
MAX_LOOPS=3
CONFIDENCE_MIN=0.7
SQL_ROW_LIMIT=200
SQL_TIMEOUT_MS=5000
MAX_TOOL_ATTEMPTS=3
GUARDRAILS_ENABLED=true
PII_REDACTION_ENABLED=true
WEB_SEARCH_ENABLED=true
TAVILY_API_KEY=

# --- observability (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LOG_LEVEL=INFO
