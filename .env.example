# Reference copy of the Compose configuration. Compose reads infra/.env.
# To run: cp infra/.env.example infra/.env, then replace every development credential.
# Keep this file synchronized with infra/.env.example and service examples.
# DEVELOPMENT ONLY defaults. Replace every password/key before any shared deployment.
POSTGRES_DB=nexusai
POSTGRES_USER=nexus
POSTGRES_PASSWORD=dev-postgres-password-change-me
SPRING_PROFILES_ACTIVE=docker
JWT_SECRET=dev-only-change-this-secret-to-at-least-32-characters
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14
COOKIE_SECURE=false
REGISTRATION_OPEN=true
ADMIN_EMAIL=admin@nexusai.local
ADMIN_PASSWORD=ChangeMe-Admin-12345
INTERNAL_API_KEY=dev-internal-key-change-me-32chars
AI_SERVICE_URL=http://ai-service:8000
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=20
MAX_DOCS_TOTAL=500
APPROVAL_TTL_DAYS=7
MAX_CONCURRENT_RUNS_PER_USER=2
RATE_LIMIT_AUTH_PER_MIN=10
CORS_ALLOWED_ORIGINS=http://localhost:5173
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
AI_DB_RW_USER=ai_rw
AI_DB_RW_PASSWORD=dev-ai-rw-password-change-me
AI_DB_RO_USER=ai_readonly
AI_DB_RO_PASSWORD=dev-ai-readonly-password-change-me
AI_DB_HOST=postgres
AI_DB_NAME=nexusai
MAX_LOOPS=3
CONFIDENCE_MIN=0.7
TOP_K=8
SQL_ROW_LIMIT=200
SQL_TIMEOUT_MS=5000
MAX_TOOL_ATTEMPTS=3
GUARDRAILS_ENABLED=true
PII_REDACTION_ENABLED=true
RERANKER_ENABLED=false
CHUNKING_MODE=semantic
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_MASK_CONTENT=true
VITE_API_BASE_URL=/api
VITE_USE_MOCKS=false
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
